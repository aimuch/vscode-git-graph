{
	"compilerOptions": {
		"declaration": true,
		"lib": [
			"es2020"
		],
		"module": "commonjs",
		"moduleResolution": "node",
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"removeComments": true,
		"sourceMap": true,
		"strict": true,
		"target": "es2020",
		"types": [
			"jest",
			"node",
			"vscode"
		]
	}
}